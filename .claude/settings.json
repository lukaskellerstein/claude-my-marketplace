{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": [
    "Welcome to My marketplace server"
  ],
  "permissions": {
    "allow": [
      "Agent",
      "Artifact",
      "Bash",
      "Cd",
      "Edit",
      "EnterWorktree",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "Monitor",
      "MultiEdit",
      "NotebookEdit",
      "PowerShell",
      "Read",
      "ShareOnboardingGuide",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",
      "mcp__demo-elevenlabs",
      "mcp__demo-playwright",
      "mcp__drawio",
      "mcp__ElevenLabs",
      "mcp__media-mcp",
      "mcp__media-playwright",
      "mcp__mermaid",
      "mcp__webdesign-playwright"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf ~*)",
      "Bash(mkfs*)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ],
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "dev-tools-plugin@claude-my-marketplace": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "denyRead": [
        "./**/.env",
        "./**/*.pem",
        "./**/*.key",
        "./**/*.agekey",
        "./**/keys.txt",
        "./**/*credentials*.json",
        "./**/serviceAccountKey.json",
        "./**/*.tfstate"
      ]
    },
    "excludedCommands": []
  }
}
